# Copy to .env.local for local dev. On Vercel these live in Project Settings -> Environment Variables.

# Postgres over the Supabase pooler. Two hosts because Supabase splits a region across clusters;
# the app tries the first, then the second.
DATABASE_URL=postgresql://chalk_server.PROJECTREF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres
DATABASE_URL_ALT=postgresql://chalk_server.PROJECTREF:PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# Signs the login cookies. Any long random string.
SESSION_SECRET=change-me

# /admin password (you).
ADMIN_PASSWORD=change-me

# Public URL, used for QR codes and Stripe return links.
APP_URL=https://chalk-bar.vercel.app

# Protects /api/cron/*. Vercel sends it automatically; n8n sends ?key=...
CRON_SECRET=change-me

# ---- Stripe. Leave blank = demo payments (no card, instant "paid"). Fill all three to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Twilio for verification texts. Leave blank = no texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# While payments are in demo mode, this fixed code verifies any phone (ignored once Stripe is live).
OTP_DEV_CODE=000000
