{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/loop-loyalty-booking-n6lu6b": false,
      "claude/viral-promo-video-editing-quo4bx": false
    }
  },
  "functions": {
    "api/render-next.js": {
      "maxDuration": 60
    },
    "api/post-next.js": {
      "maxDuration": 60
    },
    "api/ig-webhook.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/render-next",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/post-next",
      "schedule": "0 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "thebarberloop.com"
        }
      ],
      "destination": "/barbers/"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "thebarberloop.com"
        }
      ],
      "destination": "/_hosts/loop/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "thebarberloop.com"
        }
      ],
      "destination": "/_hosts/loop/sitemap.xml"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.thebarberloop.com"
        }
      ],
      "destination": "/barbers/"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.thebarberloop.com"
        }
      ],
      "destination": "/_hosts/loop/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "www.thebarberloop.com"
        }
      ],
      "destination": "/_hosts/loop/sitemap.xml"
    }
  ]
}
