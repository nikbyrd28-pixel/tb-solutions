{
  "name": "D N E Contracting - Lead Capture + Scoring + Email + SMS",
  "nodes": [
    {
      "parameters": {
        "path": "dne-leads",
        "method": "POST"
      },
      "name": "Webhook - Form Submit",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        50,
        300
      ],
      "webhookId": "webhook-dne-leads"
    },
    {
      "parameters": {
        "conditions": "AND",
        "combineOperation": "and",
        "rules": [
          {
            "condition": "datetimeBefore",
            "value1": "={{ $now }}",
            "value2": "={{ $now }}"
          }
        ]
      },
      "name": "Validate Form Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "continueOnFail": false
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "score",
              "value": "={{ $json.body.score ?? 0 }}"
            },
            {
              "name": "score_tier",
              "value": "={{ $json.body.score_tier ?? 'COLD' }}"
            },
            {
              "name": "created_at",
              "value": "={{ $now }}"
            },
            {
              "name": "status",
              "value": "new"
            }
          ]
        }
      },
      "name": "Calculate Lead Score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "host": "your-project.supabase.co",
        "database": "postgres",
        "user": "postgres",
        "password": "your-db-password",
        "ssl": true,
        "operation": "insert",
        "schema": "public",
        "table": "plumbing_leads",
        "columns": "kind,name,phone,email,town,zip,type,timeline,budget,notes,contact_pref,form,score,score_tier,status,source,utm_source,utm_medium,utm_campaign,gclid,created_at"
      },
      "name": "Save to Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "apiKey": "re_your-resend-api-key",
        "fromEmail": "hello@dne-contracting.com",
        "toEmail": "={{ $node[\"Webhook - Form Submit\"].json.body.email }}",
        "subject": "Your free consultation with D N E Contracting",
        "emailFormat": "html",
        "htmlBody": "<div style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;'>\n  <h2>Hi {{ ($node[\"Webhook - Form Submit\"].json.body.name || '').split(' ')[0] || 'there' }},</h2>\n  <p>Thanks for reaching out. We'll text or call within one business day to find a time that suits you.</p>\n  <p>The visit is free, in your home, and nothing is decided on the spot. If you'd like us to arrive already knowing the room, sketch it here (two minutes): <a href='https://www.dnecontracting.com/#sketch?type={{ $node[\"Webhook - Form Submit\"].json.body.type }}'>Sketch my room</a></p>\n  <p style='margin-top: 30px; color: #666; font-size: 12px;'>Questions? Reply to this email or call (484) 939-8535.</p>\n</div>"
      },
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.resend",
      "typeVersion": 1,
      "position": [
        850,
        150
      ],
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "accountSid": "your-twilio-account-sid",
        "authToken": "your-twilio-auth-token",
        "from": "your-twilio-phone-number",
        "to": "={{ $node[\"Webhook - Form Submit\"].json.body.phone }}",
        "message": "Hi {{ ($node[\"Webhook - Form Submit\"].json.body.name || '').split(' ')[0] || 'there' }}, D N E Contracting here. Got your request — we'll reach out within one business day. Nothing to do until then. Reply STOP to opt out."
      },
      "name": "Send SMS to Lead",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        850,
        300
      ],
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "accountSid": "your-twilio-account-sid",
        "authToken": "your-twilio-auth-token",
        "from": "your-twilio-phone-number",
        "to": "{{ env.MOM_PHONE_NUMBER }}",
        "message": "🔥 NEW LEAD ({{ $node[\"Webhook - Form Submit\"].json.body.form === 'hero_quick' ? 'quick form — no name/email yet' : 'full form' }})\nName: {{ $node[\"Webhook - Form Submit\"].json.body.name || '—' }}\nPhone: {{ $node[\"Webhook - Form Submit\"].json.body.phone }}\nEmail: {{ $node[\"Webhook - Form Submit\"].json.body.email || '—' }}\nZIP/Town: {{ $node[\"Webhook - Form Submit\"].json.body.zip || $node[\"Webhook - Form Submit\"].json.body.town || '—' }}\nProject: {{ $node[\"Webhook - Form Submit\"].json.body.type }}\nBudget: {{ $node[\"Webhook - Form Submit\"].json.body.budget || '—' }}\nTimeline: {{ $node[\"Webhook - Form Submit\"].json.body.timeline || '—' }}\nPrefers: {{ $node[\"Webhook - Form Submit\"].json.body.contact_pref || 'text' }}\nScore: {{ $node[\"Webhook - Form Submit\"].json.body.score }} ({{ $node[\"Webhook - Form Submit\"].json.body.score_tier }})\nNotes: {{ $node[\"Webhook - Form Submit\"].json.body.notes || '—' }}\n\n→ Reply to them today"
      },
      "name": "Send WhatsApp Alert to Mom",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        850,
        450
      ]
    },
    {
      "parameters": {
        "respondWithData": "{{ { \"status\": \"success\", \"message\": \"Lead received and will be contacted within 24 hours\" } }}"
      },
      "name": "Return Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - Form Submit": {
      "main": [
        [
          {
            "node": "Validate Form Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Form Data": {
      "main": [
        [
          {
            "node": "Calculate Lead Score",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calculate Lead Score": {
      "main": [
        [
          {
            "node": "Save to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Supabase": {
      "main": [
        [
          {
            "node": "Send Welcome Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send SMS to Lead",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send WhatsApp Alert to Mom",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Welcome Email": {
      "main": [
        [
          {
            "node": "Return Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send SMS to Lead": {
      "main": [
        [
          {
            "node": "Return Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Alert to Mom": {
      "main": [
        [
          {
            "node": "Return Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}