{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/remodeling-exton",
      "destination": "/remodeling-downingtown",
      "permanent": true
    },
    {
      "source": "/remodeling-malvern",
      "destination": "/remodeling-west-chester",
      "permanent": true
    },
    {
      "source": "/remodeling-kennett-square",
      "destination": "/remodeling-west-chester",
      "permanent": true
    },
    {
      "source": "/remodeling-coatesville",
      "destination": "/remodeling-downingtown",
      "permanent": true
    },
    {
      "source": "/remodeling-royersford",
      "destination": "/remodeling-phoenixville",
      "permanent": true
    },
    {
      "source": "/remodeling-collegeville",
      "destination": "/remodeling-phoenixville",
      "permanent": true
    },
    {
      "source": "/remodeling-limerick",
      "destination": "/remodeling-phoenixville",
      "permanent": true
    },
    {
      "source": "/remodeling-boyertown",
      "destination": "/remodeling-phoenixville",
      "permanent": true
    }
  ]
}
