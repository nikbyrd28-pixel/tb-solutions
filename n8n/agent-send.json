      "parameters": {
        "jsCode": "// 🔒 SEND KEY — must match the key you typed on the Agent Team page.\n// The live copy on the VPS holds the real key; this public repo copy does not.\nconst SEND_KEY = 'PASTE_YOUR_SEND_KEY';\nconst OWNER = 'nikbyrd28@gmail.com';\n\nconst body = $json.body || $json;\nconst s = (v, n) => (typeof v === 'string' ? v.trim().slice(0, n) : '');\n\nconst key = s(body.key, 64);\nconst mode = s(body.mode, 10) || 'self';\nconst to = s(body.to, 200);\nconst subject = s(body.subject, 200) || 'A note from TB Solutions';\nconst text = s(body.body, 20000);\nconst agent = s(body.agent, 40);\n\nif (key !== SEND_KEY) {\n  return [{ json: { ok: false, error: 'Wrong send key — tap \"change key\" on the page and re-enter it.' } }];\n}\nif (!text) {\n  return [{ json: { ok: false, error: 'Nothing to send — the message is empty.' } }];\n}\n\n// mode 'self' = draft to Nick's own inbox (safe test). mode 'send' = to the real recipient.\nconst target = mode === 'send' ? to : OWNER;\nconst at = target.indexOf('@');\nconst dot = target.lastIndexOf('.');\nif (at < 1 || dot < at + 2 || dot >= target.length - 1 || target.indexOf(' ') !== -1) {\n  return [{ json: { ok: false, error: 'That recipient email does not look right.' } }];\n}\n\nconst sig = '\\n\\n—\\nNick Byrd · TB Solutions\\ntbsol.net · thebarberloop.com';\n\nreturn [{ json: {\n  ok: true,\n  to: target,\n  bcc: mode === 'send' ? OWNER : '',\n  subject: mode === 'send' ? subject : '[DRAFT' + (agent ? ' · ' + agent : '') + '] ' + subject,\n  text: text + sig\n} }];\n"
      },
      "id": "s4000000-0000-4000-8000-000000000002",
      "name": "Check & Build",
      "type": "n8n-nodes-base.code",
