      "webhookId": "sms-inbound-6d4e91c7ba53"
    },
    {
      "parameters": {
        "jsCode": "// Twilio posts inbound texts here as form data. We record every one, and the\n// database honours STOP / START / HELP the moment it lands.\n//\n// 🔒 The secret below must match the one inside the sms_inbound function.\n// The live copy on the VPS holds the real value; this public repo copy does not.\nconst SECRET = 'PASTE_INBOUND_SECRET';\nconst SUPA_URL = 'https://qgbjiqdwzgkjkmqyjsmc.supabase.co';\nconst SUPA_ANON = 'PASTE_SUPABASE_ANON_KEY';\n\nconst b = $json.body || $json;\nconst s = (v, n) => (typeof v === 'string' ? v.trim().slice(0, n || 300) : '');\n\nconst from = s(b.From || b.from, 40);\nconst body = s(b.Body || b.body, 2000);\nconst sid = s(b.MessageSid || b.SmsSid || '', 60);\nconst to = s(b.To || b.to || '', 40);\n\nif (!from) {\n  return [{ json: { skip: true, reason: 'no From on the payload' } }];\n}\n\nreturn [{\n  json: {\n    url: SUPA_URL + '/rest/v1/rpc/sms_inbound',\n    apikey: SUPA_ANON,\n    payload: { p_secret: SECRET, p_from: from, p_body: body, p_sid: sid || null, p_to: to || null }\n  }\n}];\n"
      },
      "id": "i6000000-0000-4000-8000-000000000002",
      "name": "Read message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
