{
  "name": "RX — Weekly receptionist report (Mon 7am)",
  "nodes": [
    {
      "parameters": {
        "content": "## Weekly receptionist report\nEvery Monday 7am: pulls last week's numbers per client from `rx_weekly_report(7)` and texts each owner a 4-line scorecard. Also texts you a rollup.\n\n### Setup (5 min)\n1. **Get weekly numbers** node → replace PASTE_SERVICE_KEY (both headers) with the Supabase service_role key.\n2. **Text owner** + **Text Nick** nodes → replace TWILIO_SID / TWILIO_FROM and attach a Basic Auth credential (user = Account SID, password = Auth Token).\n3. **Text Nick** → set your cell in `To`.\n4. Save → flip **Active**.",
        "height": 330,
        "width": 380
      },
      "id": "note1",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-160, 20]
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "triggerAtDay": [1], "triggerAtHour": 7 }] }
      },
      "id": "sched1",
      "name": "Monday 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://qgbjiqdwzgkjkmqyjsmc.supabase.co/rest/v1/rpc/rx_weekly_report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "PASTE_SERVICE_KEY" },
            { "name": "Authorization", "value": "Bearer PASTE_SERVICE_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"days\": 7}",
        "options": {}
      },
      "id": "http1",
      "name": "Get weekly numbers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst money = c => '$' + Math.round((c||0)/100).toLocaleString();\nconst out = rows.map(r => {\n  const body = `${r.business_name} — last 7 days\\n` +\n    `📞 ${r.calls} calls answered (${r.after_hours_calls} after hours)\\n` +\n    `✅ ${r.booked} jobs booked · ✉️ ${r.messages} messages\\n` +\n    `↩️ ${r.missed_texted} missed callers texted back\\n` +\n    `≈ ${money(r.est_revenue_saved_cents)} in work captured`;\n  return { json: { ...r, body } };\n});\nconst total = rows.reduce((a,r)=>({calls:a.calls+ +r.calls, booked:a.booked+ +r.booked, rev:a.rev+ +r.est_revenue_saved_cents}),{calls:0,booked:0,rev:0});\nconst rollup = `RX rollup — ${rows.length} clients · ${total.calls} calls · ${total.booked} booked · ≈${money(total.rev)} captured`;\nreturn out.map(o => ({ json: { ...o.json, rollup } }));"
      },
      "id": "code1",
      "name": "Build scorecards",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/TWILIO_SID/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "To", "value": "={{ $json.owner_phone }}" },
            { "name": "From", "value": "TWILIO_FROM" },
            { "name": "Body", "value": "={{ $json.body }}" }
          ]
        },
        "options": {}
      },
      "id": "tw1",
      "name": "Text owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/TWILIO_SID/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "To", "value": "+1NICK_CELL" },
            { "name": "From", "value": "TWILIO_FROM" },
            { "name": "Body", "value": "={{ $json.rollup }}" }
          ]
        },
        "options": {}
      },
      "id": "tw2",
      "name": "Text Nick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "executeOnce": true,
      "position": [980, 420]
    }
  ],
  "connections": {
    "Monday 7am": { "main": [[{ "node": "Get weekly numbers", "type": "main", "index": 0 }]] },
    "Get weekly numbers": { "main": [[{ "node": "Build scorecards", "type": "main", "index": 0 }]] },
    "Build scorecards": { "main": [[{ "node": "Text owner", "type": "main", "index": 0 }, { "node": "Text Nick", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
